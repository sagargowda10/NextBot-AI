# ---------- Demo mode (works with no paid credentials) ----------
DEMO_MODE=true
AI_PROVIDER=mock            # mock | openai
PAYMENT_PROVIDER=mock       # mock | razorpay | stripe
SHIPPING_PROVIDER=mock      # mock | shiprocket
WHATSAPP_ENABLED=false
EMAIL_ENABLED=false
SEED_ON_STARTUP=true
ENVIRONMENT=local           # local | test | staging | production
LOG_LEVEL=INFO

# ---------- Databases ----------
DATABASE_URL=sqlite+aiosqlite:///./nextbot.db
# DATABASE_URL=postgresql+asyncpg://nextbot:nextbot@localhost:5432/nextbot
REDIS_URL=
MONGO_URL=
EMBEDDING_DIM=384

# ---------- Messaging / search ----------
EVENT_BUS=memory            # memory | kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SEARCH_BACKEND=database     # database | opensearch
OPENSEARCH_URL=

# ---------- Security (change every value outside local dev) ----------
JWT_SECRET=local-dev-only-secret-change-me-0123456789
WEBHOOK_SECRET=local-dev-webhook-secret
CORS_ORIGINS=["http://localhost:3000"]

# ---------- AI (optional) ----------
# OpenAI:  AI_PROVIDER=openai, OPENAI_API_KEY=sk-..., OPENAI_MODEL=gpt-4o-mini
# Gemini (free tier, key from https://aistudio.google.com/apikey):
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=<your Gemini key>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ---------- External providers (optional; adapters refuse to run without them) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- Frontend ----------
# Leave unset: the browser calls /api/... on the frontend's own address and Next.js proxies it to the backend
# (works on localhost, phones, tunnels and real domains). Set only to call a backend on another domain directly.
# NEXT_PUBLIC_API_URL=https://api.example.com

# ---------- n8n workflow automation (full stack starts n8n on :5678) ----------
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/nextbot-events   # set in docker-compose.yml; leave unset to disable
N8N_WEBHOOK_TOKEN=nextbot-n8n-demo-token
N8N_SIGNING_SECRET=nextbot-n8n-demo-signing-secret
N8N_EDITOR_URL=http://localhost:5678

# ---------- Admin AI Research (ChatGPT + web search, admin only) ----------
# Uses OPENAI_API_KEY. Without a key the page answers in demo mode from store data only.
# OPENAI_RESEARCH_MODEL=            # optional; defaults to OPENAI_MODEL. Must support the Responses API web_search tool.
RESEARCH_RATE_LIMIT_PER_MINUTE=10
RESEARCH_DAILY_LIMIT=200
